# Godot caches and exports. Keep .uid and per-asset .import sidecars in Git.
/.godot/
/.import/
/.export/
/build/
/dist/
/exports/

# Local Python environments and caches.
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Reproducible captures, logs, review images and temporary files.
/artifacts/*
!/artifacts/.gdignore
/tmp/*
!/tmp/.gdignore
/output/imagegen/anime-v2/review/
/output/font-sources/
/output/imagegen/raw/
# Downloaded reference videos (about 1 GB each) and frames extracted from them.
/output/downloads/
/output/vfx-reference/frames/
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# Machine-local environment files; keep shareable examples.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# OS metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Intentionally tracked: art/, anime-v2/raw/, prompts/, records/, imports/,
# calibration, job/asset manifests and source references for offline rebuilds.

/output/imagegen/roster-v1/review/
.venv-imagegen/

/output/pip-cache/

# Keep the selected offline inference runtime; omit downloaded archives and demos.
/output/super-resolution/*
!/output/super-resolution/runtime/
!/output/super-resolution/distribution.json

# Full downloaded video exceeds GitHub's file limit; retain locally for rebuilds.
/output/ultimate-video-review/source/original.mp4
# Preview MP4s that tools/prepare_cinematics.py cuts from it next to the game videos.
/output/ultimate-video-review/trimmed/

# Comparison sheets for every production revision are reproducible.
/output/imagegen/*/review/
